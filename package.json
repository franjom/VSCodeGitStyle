{
  "name": "vs-git-style",
  "displayName": "VS Git Style",
  "description": "Visual Studio 2026 style Git Changes panel for VS Code.",
  "version": "0.0.1",
  "publisher": "local",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vsGitStyle",
          "title": "Git Changes",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "vsGitStyle": [
        {
          "type": "webview",
          "id": "vsGitStyle.changes",
          "name": "Git Changes",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "vsGitStyle.refresh",
        "title": "Refresh",
        "category": "VS Git Style",
        "icon": "$(refresh)"
      },
      {
        "command": "vsGitStyle.openRepositoryWindow",
        "title": "Open Git Repository Window",
        "category": "VS Git Style"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "vsGitStyle.refresh",
          "when": "view == vsGitStyle.changes",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "VS Git Style",
      "properties": {
        "vsGitStyle.confirmDiscard": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before discarding changes to a file."
        },
        "vsGitStyle.graphPageSize": {
          "type": "number",
          "default": 200,
          "minimum": 20,
          "maximum": 2000,
          "description": "How many commits the Git Repository window loads per page. Rows are not virtualized, so very large pages slow the window down."
        },
        "vsGitStyle.reviewProvider": {
          "type": "string",
          "enum": [
            "auto",
            "github",
            "gitlab",
            "azure",
            "none"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Guess from the origin URL. A self-hosted host cannot be recognised this way - set the provider explicitly.",
            "GitHub pull requests.",
            "GitLab merge requests.",
            "Azure DevOps pull requests.",
            "Hide the node entirely."
          ],
          "description": "Which code review provider the Git Repository window's review node represents."
        },
        "vsGitStyle.showIgnoredFiles": {
          "type": "boolean",
          "default": false,
          "description": "Include ignored files in the Changes tree."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --no-dependencies --baseContentUrl https://local.invalid/vs-git-style --baseImagesUrl https://local.invalid/vs-git-style --out vs-git-style.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/codicons": "^0.0.36",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.5.4"
  }
}
